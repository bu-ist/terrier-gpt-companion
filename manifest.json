{
  "manifest_version": 3,
  "name": "TerrierGPT Companion",
  "version": "0.4.0",
  "description": "Read the page you are on, ask TerrierGPT, and keep the answer beside it.",
  "key": "",
  "minimum_chrome_version": "116",

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_title": "TerrierGPT Companion",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },

  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },

  "omnibox": { "keyword": "tg" },

  "permissions": [
    "sidePanel",
    "contextMenus",
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "clipboardRead",
    "nativeMessaging",
    "alarms"
  ],

  "host_permissions": [
    "https://terriergpt.bu.edu/*",
    "https://test.terriergpt-nonprod.bu.edu/*"
  ],

  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://terriergpt.bu.edu/*",
        "https://test.terriergpt-nonprod.bu.edu/*"
      ],
      "js": ["content/composer.js"],
      "run_at": "document_idle"
    }
  ],

  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+T", "mac": "Alt+Shift+T" },
      "description": "Open the TerrierGPT Companion panel"
    },
    "capture-page": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "Alt+Shift+S" },
      "description": "Capture this page (or the current selection) as context"
    },
    "send-capture": {
      "suggested_key": { "default": "Alt+Shift+Y", "mac": "Alt+Shift+Y" },
      "description": "Send the captured context to TerrierGPT"
    }
  }
}
